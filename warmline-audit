#!/usr/bin/env python3
"""claude-warmline transcript auditor.

Grades every API turn of a past Claude Code session HOT or COLD from the
usage fields recorded in its transcript (~/.claude/projects/<slug>/*.jsonl),
so keep-warm behavior can be verified after the fact instead of watching
the statusline live:

    time              gap    cache read   cache write  verdict
    08-18 10:02:45  6h12m            0        58,427   COLD(ttl)
    08-18 10:13:56    10m       62,567           710   HOT

Usage:
    warmline-audit                    # latest session of the current project
    warmline-audit TRANSCRIPT.jsonl   # a specific session
    warmline-audit --ttl 5 --json     # short-TTL setup, machine-readable
    warmline-audit --price 3          # estimate cold-cache cost in dollars,
                                      # given the model's base input $/MTok
    warmline-audit --all              # one summary line per session across
                                      # all projects, ranked by avoidable
                                      # cold tokens; --all DIR audits DIR

Verdicts (authoritative here, unlike the statusline's one-turn lag):
  HOT            the turn read its prefix from the cache
  PARTIAL        it read some cache but re-wrote more than it read
                 (prefix edited mid-conversation)
  COLD(rebuilt)  nothing read, prefix re-cached, gap within the TTL
                 (invalidation: /compact, context edits, model change)
  COLD(ttl)      nothing read, prefix re-cached after a gap beyond the TTL

Cold turns (and compact-explained PARTIALs) carry a cause where the
transcript supports one:
  session start   the first turn of a session always writes its prefix
  /compact        a compact_boundary marker (manual trigger) sits between
                  this turn and the previous one; auto-compact likewise
  model change    the model differs from the previous turn's
  inactivity      the COLD(ttl) case; "inactivity+compact" when a compact
                  also happened inside the same gap (either explains it)
  unknown         a rebuild the transcript can't explain (env/prefix drift)

Subagent (sidechain) turns are excluded: they run on separate prefixes,
and their transcripts live in separate nested files that --all skips.

Transcripts are read from $CLAUDE_CONFIG_DIR/projects (default
~/.claude/projects) -- where every local front end of the Claude Code
engine records them, terminal CLI and desktop app alike.

Reports are colorized and decorated with small bar charts when stdout is
a terminal; piped/CI output stays plain, and --json never decorates.
NO_COLOR or WARMLINE_NO_COLOR force plain; WARMLINE_FORCE_COLOR forces
color without a tty (the opt-outs still win over it).
"""
import datetime
import glob
import json
import os
import re
import sys

TTL_MIN = float(os.environ.get("WARMLINE_TTL_MIN", "60"))
# every front end that runs the Claude Code engine locally -- terminal CLI,
# desktop app, IDE extension -- records its transcripts here
PROJECTS_DIR = os.path.join(
    os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude"),
    "projects")
# a 1h-TTL cache write bills ~2x base input; a warm read ~0.1x -- the
# avoidable premium of going cold is the 1.9x difference
PREMIUM_X = 1.9

# ANSI only when a human is watching: stdout is a tty and neither NO_COLOR
# nor WARMLINE_NO_COLOR is set. WARMLINE_FORCE_COLOR turns color on without
# a tty (used by the tests); the opt-outs still win over it.
COLOR = not (os.environ.get("NO_COLOR") or os.environ.get("WARMLINE_NO_COLOR")) \
    and bool(os.environ.get("WARMLINE_FORCE_COLOR") or sys.stdout.isatty())
GREEN, YELLOW, RED, DIM, BOLD, RESET = (
    "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[1m", "\033[0m")
VERDICT_COLOR = {"HOT": GREEN, "PARTIAL": YELLOW,
                 "COLD(rebuilt)": YELLOW, "COLD(ttl)": RED}

try:  # a LANG=C pipe can't take U+2588; degrade to '#'/'.' over crashing
    "█".encode(sys.stdout.encoding or "utf-8")
    BAR_FULL, BAR_EMPTY = "█", "░"
except (UnicodeEncodeError, LookupError):
    BAR_FULL, BAR_EMPTY = "#", "."


def paint(text, color):
    return color + text + RESET if COLOR else text


def bar(frac, width=26):
    n = max(0, min(width, round(frac * width)))
    return BAR_FULL * n + BAR_EMPTY * (width - n)


def health_line(verdicts, turns):
    hot = verdicts.get("HOT", 0)
    pct = round(100.0 * hot / turns)
    color = GREEN if pct >= 90 else YELLOW if pct >= 70 else RED
    return "cache health  %s  %s  (%s of %s turns)" % (
        paint(bar(hot / turns), color), paint("%d%% hot" % pct, color),
        "{:,}".format(hot), "{:,}".format(turns))


def cause_histogram(causes):
    """One bar per cause, scaled to the biggest; pointless under two."""
    if len(causes) < 2:
        return []
    top = max(causes.values())
    lines = ["where the cold came from"]
    for c, n in sorted(causes.items(), key=lambda kv: (-kv[1], kv[0])):
        b = BAR_FULL * max(1, round(n / top * 26))
        # session start is the unavoidable one -- dim it, leaks stay loud
        lines.append("  %-19s %s  %d" % (
            c, paint(b, DIM if c == "session start" else YELLOW), n))
    return lines


def premium_line(usd):
    return paint("estimated avoidable premium ~$%.2f" % usd,
                 BOLD + (RED if usd >= 0.005 else ""))


def parse_ts(ts):
    """None on malformed input -- one corrupt line must not kill an
    --all run; naive timestamps are pinned to UTC so sorting never mixes
    aware and naive datetimes."""
    try:
        t = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    if t.tzinfo is None:
        t = t.replace(tzinfo=datetime.timezone.utc)
    return t


def parse_transcript(path):
    """(turns, compacts, label): turns are (time, read, write, model) per
    API request; compacts are sorted (time, trigger); label is the basename
    of the first assistant entry's cwd."""
    turns, seen, compacts, label = [], set(), [], None
    with open(path) as f:
        for line in f:
            # cheap prefilter: most transcript bytes are tool results in
            # user entries; only parse lines that can matter
            if "assistant" not in line and "compact_boundary" not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("isSidechain"):
                continue
            if e.get("type") == "system" and e.get("subtype") == "compact_boundary":
                bt = parse_ts(e["timestamp"]) if e.get("timestamp") else None
                if bt:
                    compacts.append((bt, (e.get("compactMetadata") or {}).get("trigger")))
                continue
            if e.get("type") != "assistant":
                continue
            msg = e.get("message") or {}
            usage = msg.get("usage") or {}
            t = parse_ts(e["timestamp"]) if e.get("timestamp") else None
            if not usage or t is None:
                continue
            # one API response spans several entries; message.id is the
            # reliable per-request key (requestId is absent on ~28% of
            # entries depending on the Claude Code version)
            rid = msg.get("id") or e.get("requestId") or e.get("uuid")
            if rid in seen:
                continue
            seen.add(rid)
            read = usage.get("cache_read_input_tokens") or 0
            write = usage.get("cache_creation_input_tokens") or 0
            if read == 0 and write == 0 and not usage.get("input_tokens"):
                continue  # synthetic entry, no real request behind it
            if label is None:
                label = os.path.basename(e.get("cwd") or "") or None
            turns.append((t, read, write, msg.get("model")))
    turns.sort(key=lambda x: x[0])
    compacts.sort(key=lambda x: x[0])
    return turns, compacts, label


def verdict_of(read, write, gap_min):
    if read > 0:
        return "PARTIAL" if write > read else "HOT"
    if write > 0:
        if gap_min is not None and gap_min > TTL_MIN:
            return "COLD(ttl)"
        return "COLD(rebuilt)"
    return "?"


def cause_of(verdict, prev_t, t, prev_model, model, compacts):
    """Attribute a cold or rewritten turn to what the transcript can
    actually show; 'unknown' rather than a guess when it can't."""
    if verdict not in ("PARTIAL", "COLD(ttl)", "COLD(rebuilt)"):
        return None
    trig = 0
    for ct, g in compacts:
        if (prev_t is None or ct > prev_t) and ct <= t:
            trig = g
    # a marker without trigger metadata is still certainly a compaction,
    # but manual-vs-auto would be a guess -- label it generically
    compact = None if trig == 0 else {
        "manual": "/compact", "auto": "auto-compact"}.get(trig, "compact")
    if verdict == "PARTIAL":
        # after a compact the shared prefix head often stays warm, so the
        # rebuild grades PARTIAL; only compact-explained ones get a cause
        return compact
    if verdict == "COLD(ttl)":
        return "inactivity+compact" if compact else "inactivity"
    if prev_t is None:
        # the first write of a session is unavoidable regardless of any
        # boundary that precedes it (e.g. a resumed continuation)
        return "session start"
    if compact:
        return compact
    if prev_model and model and model != prev_model:
        return "model change"
    return "unknown"


def grade(turns, compacts):
    """Rows with gap, verdict and cause for one session's turns."""
    rows, prev = [], None
    for t, read, write, model in turns:
        gap = (t - prev[0]).total_seconds() / 60 if prev else None
        v = verdict_of(read, write, gap)
        rows.append({"time": t, "gap_min": None if gap is None else round(gap, 1),
                     "read": read, "write": write, "verdict": v,
                     "cause": cause_of(v, prev[0] if prev else None, t,
                                       prev[1] if prev else None, model, compacts)})
        prev = (t, model)
    return rows


def summarize(rows):
    counts, causes = {}, {}
    for r in rows:
        counts[r["verdict"]] = counts.get(r["verdict"], 0) + 1
        if r["cause"]:
            causes[r["cause"]] = causes.get(r["cause"], 0) + 1
    cold = [r for r in rows if r["verdict"].startswith("COLD")]
    cold_tokens = sum(r["write"] for r in cold)
    # a session's first cache write is the price of admission, not a leak
    avoidable = sum(r["write"] for r in cold if r["cause"] != "session start")
    return {"turns": len(rows), "verdicts": counts, "causes": causes,
            "tokens_recached_cold": cold_tokens,
            "avoidable_cold_tokens": avoidable,
            "tokens_read_from_cache": sum(r["read"] for r in rows)}


def audit_session(path):
    turns, compacts, label = parse_transcript(path)
    if not turns:
        return None
    rows = grade(turns, compacts)
    s = summarize(rows)
    s["transcript"] = path
    s["project"] = label or os.path.basename(os.path.dirname(path))
    s["start"] = rows[0]["time"]
    return s, rows


def find_transcript(path):
    """Resolve the argument (or cwd) to a transcript file."""
    if path and os.path.isfile(path):
        return path
    if not path:
        slug = re.sub(r"[^A-Za-z0-9]", "-", os.getcwd())
        path = os.path.join(PROJECTS_DIR, slug)
    if os.path.isdir(path):
        files = glob.glob(os.path.join(path, "*.jsonl"))
        if files:
            return max(files, key=os.path.getmtime)
    sys.exit("warmline-audit: no transcript found at %r "
             "(pass a session .jsonl or run inside a project)" % path)


def discover(root):
    """Session transcripts under a projects root (or one project dir).
    Subagent transcripts live deeper (<session>/subagents/) and are skipped."""
    if os.path.isfile(root):
        return [root]
    files = set(glob.glob(os.path.join(root, "*", "*.jsonl")))
    files.update(glob.glob(os.path.join(root, "*.jsonl")))
    return sorted(files)


def fmt_gap(m):
    if m is None:
        return "-"
    if m < 1:
        return "<1m"
    if m < 90:
        return "%dm" % m
    return "%dh%02dm" % (m // 60, m % 60)


def fmt_causes(causes):
    order = ["inactivity", "inactivity+compact", "/compact", "auto-compact",
             "compact", "model change", "unknown", "session start"]
    return "  ".join("%s %d" % (c, causes[c]) for c in order if causes.get(c))


def print_single(path, price, as_json):
    audited = audit_session(path)
    if audited is None:
        sys.exit("warmline-audit: no API turns with usage in %s" % path)
    s, rows = audited
    out_rows = [{"time": r["time"].astimezone().strftime("%m-%d %H:%M:%S"),
                 "gap_min": r["gap_min"], "read": r["read"], "write": r["write"],
                 "verdict": r["verdict"], "cause": r["cause"]} for r in rows]
    summary = {"transcript": path, "ttl_min": TTL_MIN, "turns": s["turns"],
               "verdicts": s["verdicts"], "causes": s["causes"],
               "tokens_recached_cold": s["tokens_recached_cold"],
               "avoidable_cold_tokens": s["avoidable_cold_tokens"],
               "tokens_read_from_cache": s["tokens_read_from_cache"]}
    if price is not None:
        summary["cold_extra_usd"] = round(
            s["tokens_recached_cold"] * PREMIUM_X * price / 1e6, 4)
        summary["cache_read_usd"] = round(
            s["tokens_read_from_cache"] * 0.1 * price / 1e6, 4)
    if as_json:
        print(json.dumps({"summary": summary, "turns": out_rows}, indent=1))
        return

    print("%s  (ttl %gm)" % (path, TTL_MIN))
    print("%-15s  %6s  %11s  %12s  %s" % ("time", "gap", "cache read", "cache write", "verdict"))
    for r in out_rows:
        v = paint(r["verdict"], VERDICT_COLOR.get(r["verdict"], DIM))
        if r["cause"] and r["cause"] != "inactivity":
            v += paint("  <- " + r["cause"], DIM)
        print("%-15s  %6s  %11s  %12s  %s"
              % (r["time"], fmt_gap(r["gap_min"]), "{:,}".format(r["read"]),
                 "{:,}".format(r["write"]), v))
    print()
    if s["turns"] >= 5:  # a 1-turn bar is noise
        print(health_line(s["verdicts"], s["turns"]))
        print()
    print("%d API turns; %s" % (s["turns"], "  ".join(
        "%s %d" % (v, s["verdicts"][v]) for v in
        ("HOT", "PARTIAL", "COLD(rebuilt)", "COLD(ttl)", "?") if v in s["verdicts"])))
    if s["causes"]:
        print("causes: %s" % fmt_causes(s["causes"]))
    print("tokens re-cached while cold: {:,}   read from cache: {:,}".format(
        s["tokens_recached_cold"], s["tokens_read_from_cache"]))
    print("(a cold re-cache bills ~2x base input; a warm wake reads at ~0.1x)")
    if price is not None:
        print("at $%g/MTok base input: the cold re-caches cost ~$%.2f more than "
              "warm reads of the same tokens would have; cache reads billed ~$%.2f"
              % (price, summary["cold_extra_usd"], summary["cache_read_usd"]))
        print(premium_line(s["avoidable_cold_tokens"] * PREMIUM_X * price / 1e6))


def print_all(root, price, as_json):
    sessions, skipped = [], 0
    for path in discover(root):
        audited = audit_session(path)
        if audited is None:
            skipped += 1
            continue
        sessions.append(audited[0])
    if not sessions:
        sys.exit("warmline-audit: no auditable sessions under %s" % root)
    sessions.sort(key=lambda s: (-s["avoidable_cold_tokens"],
                                 -s["tokens_recached_cold"], s["start"]))

    total = {"sessions": len(sessions), "skipped": skipped, "turns": 0,
             "verdicts": {}, "causes": {}, "tokens_recached_cold": 0,
             "avoidable_cold_tokens": 0, "tokens_read_from_cache": 0}
    for s in sessions:
        total["turns"] += s["turns"]
        for k in ("tokens_recached_cold", "avoidable_cold_tokens",
                  "tokens_read_from_cache"):
            total[k] += s[k]
        for d, src in (("verdicts", s["verdicts"]), ("causes", s["causes"])):
            for k, n in src.items():
                total[d][k] = total[d].get(k, 0) + n
    if price is not None:
        total["avoidable_premium_usd"] = round(
            total["avoidable_cold_tokens"] * PREMIUM_X * price / 1e6, 2)

    if as_json:
        out = []
        for s in sessions:
            o = dict(s, start=s["start"].isoformat())
            if price is not None:
                o["avoidable_premium_usd"] = round(
                    s["avoidable_cold_tokens"] * PREMIUM_X * price / 1e6, 2)
            out.append(o)
        print(json.dumps({"root": root, "ttl_min": TTL_MIN,
                          "sessions": out, "total": total}, indent=1))
        return

    print("%d sessions under %s  (%d more without API turns; ttl %gm)"
          % (len(sessions), root, skipped, TTL_MIN))
    print()
    print(health_line(total["verdicts"], total["turns"]))
    rebuilt = total["verdicts"].get("COLD(rebuilt)", 0)
    expired = total["verdicts"].get("COLD(ttl)", 0)
    cold_n = rebuilt + expired
    print("cold events   %s  (%d rebuilt, %d ttl)" % (
        paint("{:,}".format(cold_n), YELLOW if cold_n else GREEN),
        rebuilt, expired))
    print()
    head = "%-12s %-22s %6s %6s %5s %8s %5s %15s" % (
        "start", "project", "turns", "hot", "part", "rebuilt", "ttl", "avoidable cold")
    if price is not None:
        head += "  %9s" % "premium"
    print(head)
    for s in sessions + [None]:
        if s is None:
            line = "%-12s %-22s %6d %6d %5d %8d %5d %15s" % (
                "TOTAL", "", total["turns"], total["verdicts"].get("HOT", 0),
                total["verdicts"].get("PARTIAL", 0),
                total["verdicts"].get("COLD(rebuilt)", 0),
                total["verdicts"].get("COLD(ttl)", 0),
                "{:,}".format(total["avoidable_cold_tokens"]))
            if price is not None:
                line += "  %9s" % ("$%.2f" % total["avoidable_premium_usd"])
            print()
            print(paint(line, BOLD))
            continue
        v = s["verdicts"]
        line = "%-12s %-22s %6d %6d %5d %8d %5d %15s" % (
            s["start"].astimezone().strftime("%m-%d %H:%M"), s["project"][:22],
            s["turns"], v.get("HOT", 0), v.get("PARTIAL", 0),
            v.get("COLD(rebuilt)", 0), v.get("COLD(ttl)", 0),
            "{:,}".format(s["avoidable_cold_tokens"]))
        if price is not None:
            prem = s["avoidable_cold_tokens"] * PREMIUM_X * price / 1e6
            # pad before painting: ANSI is zero-width on screen, not to %9s
            line += "  " + paint("%9s" % ("$%.2f" % prem),
                                 RED if prem > 1 else DIM)
        print(line)
    print()
    if total["causes"]:
        print("causes: %s" % fmt_causes(total["causes"]))
        hist = cause_histogram(total["causes"])
        if hist:
            print()
            for ln in hist:
                print(ln)
            print()
    print("avoidable cold = tokens re-cached cold, excluding each session's "
          "unavoidable first write")
    if price is not None:
        print("premium = estimated avoidable premium of those re-caches vs warm "
              "reads (%.1fx $%g/MTok);" % (PREMIUM_X, price))
        print("an estimate from recorded token counts, not billing data")
        print()
        line = premium_line(total["avoidable_premium_usd"])
        if len(sessions) > 5:
            # concentration: is the leak a few bad sessions or everywhere?
            top_tok = sum(s["avoidable_cold_tokens"] for s in sessions[:5])
            rest_tok = total["avoidable_cold_tokens"] - top_tok
            line += "  (top 5 sessions: $%.2f, other %d: $%.2f)" % (
                top_tok * PREMIUM_X * price / 1e6, len(sessions) - 5,
                rest_tok * PREMIUM_X * price / 1e6)
        print(line)
    else:
        print("pass --price <$/MTok base input> for an estimated avoidable "
              "premium in dollars")


def take_number(args, flag):
    if flag not in args:
        return None
    i = args.index(flag)
    if i + 1 >= len(args):
        sys.exit("warmline-audit: %s needs a number" % flag)
    try:
        v = float(args[i + 1])
    except ValueError:
        sys.exit("warmline-audit: %s needs a number, got %r"
                 % (flag, args[i + 1]))
    del args[i:i + 2]
    return v


def main():
    args = sys.argv[1:]
    ttl = take_number(args, "--ttl")
    price = take_number(args, "--price")
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    do_all = "--all" in args
    args = [a for a in args if a != "--all"]
    if ttl is not None:
        global TTL_MIN
        TTL_MIN = ttl

    if do_all:
        root = args[0] if args else PROJECTS_DIR
        print_all(root, price, as_json)
    else:
        print_single(find_transcript(args[0] if args else None), price, as_json)


if __name__ == "__main__":
    main()
