#!/usr/bin/env python3
"""claude-warmline transcript auditor.

Grades every API turn of a past Claude Code session HOT or COLD from the
usage fields recorded in its transcript (~/.claude/projects/<slug>/*.jsonl),
so keep-warm behavior can be verified after the fact instead of watching
the statusline live:

    time              gap    cache read   cache write  verdict
    08-18 10:02:45  6h12m            0        58,427   COLD(ttl)
    08-18 10:13:56    10m       62,567           710   HOT

Usage:
    warmline-audit                    # latest session of the current project
    warmline-audit TRANSCRIPT.jsonl   # a specific session
    warmline-audit --ttl 5 --json     # short-TTL setup, machine-readable

Verdicts (authoritative here, unlike the statusline's one-turn lag):
  HOT            the turn read its prefix from the cache
  PARTIAL        it read some cache but re-wrote more than it read
                 (prefix edited mid-conversation)
  COLD(rebuilt)  nothing read, prefix re-cached, gap within the TTL
                 (invalidation: /compact, context edits, model change)
  COLD(ttl)      nothing read, prefix re-cached after a gap beyond the TTL

Subagent (sidechain) turns are excluded: they run on separate prefixes.
"""
import datetime
import glob
import json
import os
import re
import sys

TTL_MIN = float(os.environ.get("WARMLINE_TTL_MIN", "60"))


def find_transcript(path):
    """Resolve the argument (or cwd) to a transcript file."""
    if path and os.path.isfile(path):
        return path
    if not path:
        slug = re.sub(r"[^A-Za-z0-9]", "-", os.getcwd())
        path = os.path.expanduser("~/.claude/projects/" + slug)
    if os.path.isdir(path):
        files = glob.glob(os.path.join(path, "*.jsonl"))
        if files:
            return max(files, key=os.path.getmtime)
    sys.exit("warmline-audit: no transcript found at %r "
             "(pass a session .jsonl or run inside a project)" % path)


def turns_of(path):
    """One (timestamp, cache_read, cache_write) per API request."""
    turns, seen = [], set()
    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("type") != "assistant" or e.get("isSidechain"):
                continue
            usage = (e.get("message") or {}).get("usage") or {}
            ts = e.get("timestamp")
            if not usage or not ts:
                continue
            rid = e.get("requestId") or (e.get("message") or {}).get("id") or e.get("uuid")
            if rid in seen:
                continue
            seen.add(rid)
            read = usage.get("cache_read_input_tokens") or 0
            write = usage.get("cache_creation_input_tokens") or 0
            if read == 0 and write == 0 and not usage.get("input_tokens"):
                continue  # synthetic entry, no real request behind it
            t = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
            turns.append((t, read, write))
    turns.sort(key=lambda x: x[0])
    return turns


def verdict_of(read, write, gap_min):
    if read > 0:
        return "PARTIAL" if write > read else "HOT"
    if write > 0:
        if gap_min is not None and gap_min > TTL_MIN:
            return "COLD(ttl)"
        return "COLD(rebuilt)"
    return "?"


def fmt_gap(m):
    if m is None:
        return "-"
    if m < 1:
        return "<1m"
    if m < 90:
        return "%dm" % m
    return "%dh%02dm" % (m // 60, m % 60)


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    if "--ttl" in args:
        i = args.index("--ttl")
        global TTL_MIN
        TTL_MIN = float(args[i + 1])
        del args[i:i + 2]
    path = find_transcript(args[0] if args else None)

    rows, prev = [], None
    for t, read, write in turns_of(path):
        gap = (t - prev).total_seconds() / 60 if prev else None
        rows.append({"time": t.astimezone().strftime("%m-%d %H:%M:%S"),
                     "gap_min": None if gap is None else round(gap, 1),
                     "read": read, "write": write,
                     "verdict": verdict_of(read, write, gap)})
        prev = t
    if not rows:
        sys.exit("warmline-audit: no API turns with usage in %s" % path)

    counts = {}
    for r in rows:
        counts[r["verdict"]] = counts.get(r["verdict"], 0) + 1
    cold_tokens = sum(r["write"] for r in rows if r["verdict"].startswith("COLD"))
    read_tokens = sum(r["read"] for r in rows)
    summary = {"transcript": path, "ttl_min": TTL_MIN, "turns": len(rows),
               "verdicts": counts, "tokens_recached_cold": cold_tokens,
               "tokens_read_from_cache": read_tokens}

    if as_json:
        print(json.dumps({"summary": summary, "turns": rows}, indent=1))
        return

    print("%s  (ttl %gm)" % (path, TTL_MIN))
    print("%-15s  %6s  %11s  %12s  %s" % ("time", "gap", "cache read", "cache write", "verdict"))
    for r in rows:
        print("%-15s  %6s  %11s  %12s  %s"
              % (r["time"], fmt_gap(r["gap_min"]), "{:,}".format(r["read"]),
                 "{:,}".format(r["write"]), r["verdict"]))
    print()
    print("%d API turns; %s" % (len(rows), "  ".join(
        "%s %d" % (v, counts[v]) for v in
        ("HOT", "PARTIAL", "COLD(rebuilt)", "COLD(ttl)", "?") if v in counts)))
    print("tokens re-cached while cold: {:,}   read from cache: {:,}".format(
        cold_tokens, read_tokens))
    print("(a cold re-cache bills ~2x base input; a warm wake reads at ~0.1x)")


if __name__ == "__main__":
    main()
