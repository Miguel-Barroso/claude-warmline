#!/usr/bin/env bash
set -euo pipefail

# claude-warmline control CLI.
#
# The installer (install.sh) installs, updates and uninstalls; this command
# controls what's installed. `warmline --help` lists the subcommands.

# last-resort source for the keep-warm policy text; WARMLINE_REF pins it to the
# same tag a pinned install used, so the fallback can't drift to main's wording
REPO_RAW="https://raw.githubusercontent.com/Miguel-Barroso/claude-warmline/${WARMLINE_REF:-main}"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
DEST="$CLAUDE_DIR/warmline-statusline.py"
SETTINGS="$CLAUDE_DIR/settings.json"
CLAUDE_MD="$CLAUDE_DIR/CLAUDE.md"
POLICY="$CLAUDE_DIR/warmline-keep-warm.md"
MARK_BEGIN="<!-- >>> claude-warmline keep-warm >>> -->"
MARK_END="<!-- <<< claude-warmline keep-warm <<< -->"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || true)"

usage() {
  cat <<EOF
claude-warmline: cache-aware statusline, session auditor, keep-warm policy.
The installer (install.sh) installs and updates; this command controls.

  warmline status              what is installed and enabled right now
  warmline setup               wire the statusline into Claude Code (what
                               install.sh does; run it after brew or a package)
  warmline watch [-n SECS]     live warmth view of every session, refreshed
                               every 10s (or SECS) until ctrl-c
  warmline awake [CMD...]      no-sleep mode: run 'claude' (or CMD) with
                               system sleep held off until it exits
  warmline wait-for TARGET     block until a detached job finishes, so its
                               end wakes the session (run as a background task)
  warmline keep-warm on        turn the keep-warm policy ON (global)
  warmline keep-warm off       turn it OFF -- removes only warmline's block
  warmline keep-warm status    detailed state; exit 0=ON  1=OFF  2=INCONSISTENT
  warmline audit [args...]     run warmline-audit (grades past sessions)
  warmline --help              this text

Config dir: $CLAUDE_DIR  (override with CLAUDE_CONFIG_DIR)
EOF
}

kw_usage() {
  cat <<EOF
warmline keep-warm: the optional prevention half of claude-warmline.
ON appends a marker-delimited policy block to
$CLAUDE_MD
instructing the agent to keep the prompt cache warm through long waits.

  warmline keep-warm on        append the block (idempotent; global)
  warmline keep-warm off       remove exactly that block, nothing else
  warmline keep-warm status    ON / OFF / INCONSISTENT; exit 0 / 1 / 2

Policy text comes from $POLICY (installed),
falling back to keep-warm.md next to this script, then the repository.
EOF
}

# on: both markers present. begin-only/end-only: a malformed block (one
# marker without its pair -- e.g. a hand edit went wrong). off: neither.
kw_state() {
  local b=0 e=0
  if [ -f "$CLAUDE_MD" ]; then
    if grep -qF "$MARK_BEGIN" "$CLAUDE_MD"; then b=1; fi
    if grep -qF "$MARK_END" "$CLAUDE_MD"; then e=1; fi
  fi
  if [ "$b$e" = 11 ]; then echo on
  elif [ "$b$e" = 10 ]; then echo begin-only
  elif [ "$b$e" = 01 ]; then echo end-only
  else echo off; fi
}

kw_remove_block() { # both markers known present; user text around it survives
  MB="$MARK_BEGIN" ME="$MARK_END" python3 - "$CLAUDE_MD" <<'PY'
import os, sys
path = sys.argv[1]
text = open(path).read()
mb, me = os.environ["MB"], os.environ["ME"]
head, rest = text.split(mb, 1)
_, tail = rest.split(me, 1)
open(path, "w").write(head.rstrip() + "\n" + tail.lstrip("\n"))
PY
}

kw_remove_orphan() { # only the marker line itself is provably warmline's
  MB="$MARK_BEGIN" ME="$MARK_END" python3 - "$CLAUDE_MD" <<'PY'
import os, sys
path = sys.argv[1]
lines = open(path).read().splitlines(True)
marks = (os.environ["MB"], os.environ["ME"])
open(path, "w").write("".join(l for l in lines if l.strip() not in marks))
PY
}

policy_body() {
  if [ -f "$POLICY" ]; then
    cat "$POLICY"
  elif [ -n "$SELF_DIR" ] && [ -f "$SELF_DIR/keep-warm.md" ]; then
    cat "$SELF_DIR/keep-warm.md"
  elif command -v curl >/dev/null; then
    curl -fsSL "$REPO_RAW/keep-warm.md"
  else
    wget -qO- "$REPO_RAW/keep-warm.md"
  fi
}

kw_on() {
  case "$(kw_state)" in
    on) echo "keep-warm already ON"; return 0 ;;
    begin-only|end-only)
      echo "warmline: the keep-warm block in $CLAUDE_MD is malformed" >&2
      echo "(one marker without its pair). Run 'warmline keep-warm off' to" >&2
      echo "remove warmline's markers, review the file, then 'on' again." >&2
      return 2 ;;
  esac
  local body
  body="$(policy_body)" || {
    echo "warmline: no keep-warm policy text found ($POLICY missing," >&2
    echo "no checkout copy, no network); re-run install.sh first" >&2
    return 1
  }
  mkdir -p "$CLAUDE_DIR"
  touch "$CLAUDE_MD"
  printf '\n%s\n%s\n%s\n' "$MARK_BEGIN" "$body" "$MARK_END" >> "$CLAUDE_MD"
  echo "keep-warm ON (policy appended to $CLAUDE_MD)"
}

kw_off() {
  case "$(kw_state)" in
    on)
      kw_remove_block
      echo "keep-warm OFF (block removed from $CLAUDE_MD)" ;;
    begin-only|end-only)
      kw_remove_orphan
      echo "keep-warm OFF (removed an orphaned warmline marker)"
      echo "warmline: the block was malformed; review $CLAUDE_MD for leftover policy text" >&2 ;;
    off) echo "keep-warm already OFF" ;;
  esac
}

kw_status() {
  case "$(kw_state)" in
    on)
      local pol="intact"
      if [ -f "$POLICY" ]; then
        if ! MB="$MARK_BEGIN" ME="$MARK_END" python3 - "$CLAUDE_MD" "$POLICY" <<'PY'
import os, re, sys
text = open(sys.argv[1]).read()
body = text.split(os.environ["MB"], 1)[1].split(os.environ["ME"], 1)[0]
norm = lambda s: re.sub(r"\s+", " ", s).strip()
sys.exit(0 if norm(body) == norm(open(sys.argv[2]).read()) else 1)
PY
        then
          pol="modified -- differs from $POLICY
           (refresh: warmline keep-warm off && warmline keep-warm on)"
        fi
      fi
      echo "keep-warm  ON"
      echo "  scope    global -- applies to every project  (block in $CLAUDE_MD)"
      echo "  policy   $pol"
      return 0 ;;
    off)
      echo "keep-warm  OFF"
      echo "  enable   warmline keep-warm on"
      return 1 ;;
    begin-only)
      echo "keep-warm  INCONSISTENT"
      echo "  found    begin marker without its end marker in $CLAUDE_MD"
      echo "  fix      warmline keep-warm off  (removes warmline's markers only), then on"
      return 2 ;;
    end-only)
      echo "keep-warm  INCONSISTENT"
      echo "  found    end marker without its begin marker in $CLAUDE_MD"
      echo "  fix      warmline keep-warm off  (removes warmline's markers only), then on"
      return 2 ;;
  esac
}

find_audit() {
  if [ -n "$SELF_DIR" ] && [ -x "$SELF_DIR/warmline-audit" ]; then
    echo "$SELF_DIR/warmline-audit"
  else
    command -v warmline-audit || true
  fi
}

# Where statusline.py and keep-warm.md live. install.sh puts them in the config
# dir itself; a package manager puts the CLI on PATH and the data files beside
# it (prefix/share/warmline), which is what this resolves. Symlinks are followed
# because `brew link` puts one in prefix/bin pointing into the Cellar.
share_dir() {
  local p="${BASH_SOURCE[0]:-$0}" d n=0
  while [ -L "$p" ] && [ "$n" -lt 16 ]; do
    n=$((n + 1))
    d="$(cd "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  d="$(cd "$(dirname "$p")" 2>/dev/null && pwd || true)"
  for c in "${WARMLINE_SHARE_DIR:-}" "$d" "$d/../share/warmline"; do
    [ -n "$c" ] && [ -f "$c/statusline.py" ] && { (cd "$c" && pwd); return 0; }
  done
  return 1
}

setup_usage() {
  cat <<EOF
warmline setup: wire the statusline into Claude Code.

  warmline setup            install the statusline and policy text, wire settings.json
  warmline setup --force    with install: replace a statusLine that isn't warmline's
  warmline setup --remove   unwire it and remove the files this command installed

install.sh does this as part of installing. Run it yourself after a package
manager (brew, a distro package) has put the commands on PATH but left
$CLAUDE_DIR alone -- packages don't get to edit your Claude Code config.

Removing the keep-warm block is separate: warmline keep-warm off.
EOF
}

cmd_setup() {
  local force=0 remove=0 src
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --remove|--uninstall) remove=1 ;;
      --help|-h) setup_usage; return 0 ;;
      *) echo "warmline setup: unknown flag '$1' (see warmline setup --help)" >&2; return 2 ;;
    esac
    shift
  done
  if [ "$remove" = 1 ] && [ "$force" = 1 ]; then
    echo "warmline setup: --remove and --force don't go together" >&2; return 2
  fi

  if [ "$remove" = 1 ]; then
    if [ -f "$SETTINGS" ]; then
      DEST="$DEST" python3 - "$SETTINGS" <<'PY'
import json, os, sys
path = sys.argv[1]
try:
    d = json.load(open(path))
except Exception:
    sys.exit(0)
sl = d.get("statusLine") or {}
if os.environ["DEST"] in str(sl.get("command", "")):
    del d["statusLine"]
    with open(path, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")
    print(f"removed statusLine from {path}")
PY
    fi
    rm -f "$DEST" "$POLICY"
    echo "warmline setup removed (the commands themselves are your package manager's)"
    [ "$(kw_state)" = on ] && echo "note: keep-warm is still ON -- 'warmline keep-warm off' removes that block"
    return 0
  fi

  src="$(share_dir)" || {
    echo "warmline: can't find statusline.py next to this command" >&2
    echo "(looked beside it and in ../share/warmline; set WARMLINE_SHARE_DIR" >&2
    echo "to the directory holding statusline.py and keep-warm.md)" >&2
    return 1
  }
  mkdir -p "$CLAUDE_DIR"
  cp "$src/statusline.py" "$DEST"; chmod +x "$DEST"
  echo "installed $DEST"
  local prev=""
  if [ -f "$src/keep-warm.md" ]; then
    if [ -f "$POLICY" ]; then prev="$(mktemp)"; cp "$POLICY" "$prev"; fi
    cp "$src/keep-warm.md" "$POLICY"
    echo "installed $POLICY"
    # the block already in CLAUDE.md is what the agent reads, so refreshing only
    # $POLICY would leave every session on the previous release's wording
    if [ -f "$CLAUDE_MD" ]; then
      MB="$MARK_BEGIN" ME="$MARK_END" PREV="$prev" \
        python3 - "$CLAUDE_MD" "$POLICY" <<'PY'
import os, re, sys
md, policy = sys.argv[1], sys.argv[2]
mb, me = os.environ["MB"], os.environ["ME"]
text = open(md).read()
if mb not in text or me not in text:
    sys.exit(0)
head, rest = text.split(mb, 1)
body, tail = rest.split(me, 1)
new = open(policy).read()
norm = lambda s: re.sub(r"\s+", " ", s).strip()
if norm(body) == norm(new):
    sys.exit(0)
prev = os.environ.get("PREV") or ""
prev = open(prev).read() if prev and os.path.exists(prev) else None
if prev is not None and norm(body) == norm(prev):
    open(md, "w").write(head + mb + "\n" + new.rstrip() + "\n" + me + tail)
    print(f"refreshed the keep-warm block in {md} (policy updated)")
else:
    print(f"note: the keep-warm block in {md} differs from the policy just")
    print("installed and does not match the one it replaced, so it looks")
    print("hand-edited -- left untouched. To adopt the new wording, run:")
    print("  warmline keep-warm off && warmline keep-warm on")
PY
    fi
    [ -n "$prev" ] && rm -f "$prev"
  fi

  DEST="$DEST" FORCE="$force" python3 - "$SETTINGS" <<'PY'
import json, os, shutil, sys
path, dest = sys.argv[1], os.environ["DEST"]
force = os.environ["FORCE"] == "1"
d = {}
if os.path.exists(path):
    with open(path) as f:
        d = json.load(f)
    shutil.copyfile(path, path + ".warmline-bak")
sl = d.get("statusLine")
if sl and dest not in str(sl.get("command", "")) and not force:
    print(f"settings.json already has a statusLine: {sl.get('command')!r}")
    print("re-run with --force to replace it (backup: settings.json.warmline-bak)")
    sys.exit(1)
new = dict(sl) if isinstance(sl, dict) and dest in str(sl.get("command", "")) else {}
new.update({"type": "command", "command": dest})
refresh = os.environ.get("WARMLINE_REFRESH_SEC")
if refresh is not None:
    try:
        refresh = int(float(refresh))
    except ValueError:
        sys.exit(f"WARMLINE_REFRESH_SEC must be a number, got {refresh!r}")
    if refresh > 0:
        new["refreshInterval"] = refresh
    else:
        new.pop("refreshInterval", None)
else:
    new.setdefault("refreshInterval", 60)
d["statusLine"] = new
with open(path, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
r = new.get("refreshInterval")
how = f"self-refreshes every {r}s while idle" if r else "event-driven only"
print(f"statusLine wired in {path}  ({how})")
PY
}

cmd_status() {
  local wired=none settings_ttl="" refresh="" sl_line kw_line audit_line ttl_line refresh_line="" audit_path
  if [ -f "$SETTINGS" ]; then
    # '|'-separated: a non-whitespace IFS keeps empty fields, where
    # consecutive tabs would collapse and shift the columns
    IFS='|' read -r wired settings_ttl refresh < <(DEST="$DEST" python3 - "$SETTINGS" <<'PY'
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
sl = d.get("statusLine") or {}
cmd = str(sl.get("command", ""))
state = "warmline" if os.environ["DEST"] in cmd else ("foreign" if cmd else "none")
print(state + "|" + str((d.get("env") or {}).get("WARMLINE_TTL_MIN", ""))
      + "|" + str(sl.get("refreshInterval") or ""))
PY
) || true
  fi
  if [ -f "$DEST" ] && [ "$wired" = warmline ]; then
    sl_line="ON   $DEST"
  elif [ "$wired" = foreign ] && [ -f "$DEST" ]; then
    sl_line="OFF  ($DEST installed, but settings.json runs a different statusline; 'warmline setup --force' replaces it)"
  elif [ "$wired" = warmline ]; then
    sl_line="OFF  (wired in settings.json but $DEST is missing; run 'warmline setup')"
  else
    sl_line="OFF  (wire it: warmline setup)"
  fi
  case "$(kw_state)" in
    on)  kw_line="ON   (details: warmline keep-warm status)" ;;
    off) kw_line="OFF  (enable: warmline keep-warm on)" ;;
    *)   kw_line="INCONSISTENT  (details: warmline keep-warm status)" ;;
  esac
  audit_path="$(find_audit)"
  if [ -n "$audit_path" ]; then
    audit_line="ON   $audit_path"
  else
    audit_line="OFF  (install: install.sh, or brew install warmline)"
  fi
  if [ -n "${WARMLINE_TTL_MIN:-}" ]; then
    ttl_line="${WARMLINE_TTL_MIN}m (WARMLINE_TTL_MIN)"
  elif [ -n "${settings_ttl:-}" ]; then
    ttl_line="${settings_ttl}m (settings.json env)"
  else
    ttl_line="auto -- warmline-audit reads it per transcript (60m fallback); the statusline uses Claude Code's own"
  fi
  if [ "$wired" = warmline ]; then
    if [ -n "$refresh" ]; then
      refresh_line="every ${refresh}s while idle -- the gauge can't go stale"
    else
      refresh_line="OFF -- event-driven only; an idle line freezes (re-run install.sh)"
    fi
  fi
  echo "claude-warmline status  (config: $CLAUDE_DIR)"
  printf '  %-10s  %s\n' statusline "$sl_line" keep-warm "$kw_line" \
    auditor "$audit_line" ttl "$ttl_line"
  [ -n "$refresh_line" ] && printf '  %-10s  %s\n' refresh "$refresh_line"
  return 0
}

cmd_audit() {
  local audit_path
  audit_path="$(find_audit)"
  if [ -z "$audit_path" ]; then
    echo "warmline: warmline-audit not found (re-run install.sh)" >&2
    exit 1
  fi
  exec "$audit_path" "$@"
}

watch_usage() {
  cat <<EOF
warmline watch: a live warmth view of every session on this machine,
computed from the transcripts now -- not the statusline's one-turn lag --
and re-rendered until ctrl-c. Works for desktop-app sessions too (they
write the same transcripts but have no statusline surface).

  warmline watch               refresh every 10 seconds
  warmline watch -n SECS       refresh every SECS seconds

One-shot form (scriptable): warmline audit --live [--json]
EOF
}

cmd_watch() {
  local interval=10 audit_path
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) interval="${2:-}"; shift 2 || { echo "warmline: -n needs seconds" >&2; exit 2; } ;;
      --help|-h|help) watch_usage; exit 0 ;;
      *) echo "warmline: unknown watch flag '$1' (see warmline watch --help)" >&2; exit 2 ;;
    esac
  done
  case "$interval" in
    ''|*[!0-9]*) echo "warmline: -n needs a whole number of seconds" >&2; exit 2 ;;
  esac
  audit_path="$(find_audit)"
  if [ -z "$audit_path" ]; then
    echo "warmline: warmline-audit not found (re-run install.sh)" >&2
    exit 1
  fi
  # --live is captured, so its isatty is false; re-enable color when watch
  # itself faces a terminal (the NO_COLOR opt-outs still win inside audit)
  local force=""
  [ -t 1 ] && force=1
  while :; do
    out="$(WARMLINE_FORCE_COLOR="${WARMLINE_FORCE_COLOR:-$force}" "$audit_path" --live)" || true
    printf '\033[H\033[2J%s\n\n(every %ss; ctrl-c to stop)\n' "$out" "$interval"
    sleep "$interval"
  done
}

awake_usage() {
  cat <<EOF
warmline awake: no-sleep mode for the duration of one Claude session.
Runs COMMAND (default: claude) with the machine's system/idle sleep
inhibited, so keep-warm pings can actually fire through a long wait --
a sleeping host is the one thing they never survive.

  warmline awake                    keep the machine awake for one
                                    'claude' session
  warmline awake claude --resume    ...or wrap any command you pass
  warmline awake --help             this text

The inhibition lives exactly as long as the wrapped command: when the
session ends -- /exit, ctrl-c, a crash -- the operating system releases
it and normal sleep behavior returns. There is no state to clean up and
no way to be left permanently sleepless. The display may still sleep;
only system sleep is held off.

Mechanism: 'caffeinate -is COMMAND' on macOS, 'systemd-inhibit COMMAND'
on Linux.
EOF
}

cmd_awake() {
  case "${1:-}" in
    --help|-h|help) awake_usage; exit 0 ;;
    -*) echo "warmline: unknown awake flag '${1}' -- flags for the wrapped" >&2
        echo "command go after its name, e.g.: warmline awake claude --resume" >&2
        exit 2 ;;
  esac
  [ $# -gt 0 ] || set -- claude
  # exec ties the inhibitor's lifetime to this very process: the wrapped
  # command's exit (however it exits) is what releases the assertion
  if command -v caffeinate >/dev/null; then
    exec caffeinate -is "$@"
  elif command -v systemd-inhibit >/dev/null; then
    exec systemd-inhibit --what=sleep:idle \
      --why="claude session (warmline awake)" "$@"
  else
    echo "warmline: no sleep inhibitor found (needs caffeinate on macOS" >&2
    echo "or systemd-inhibit on Linux)" >&2
    exit 1
  fi
}

wait_for_usage() {
  cat <<EOF
warmline wait-for: block until a job running outside the harness finishes,
so its end -- success or failure -- is what wakes the session. Run it AS a
harness background task, watching a worker you detached beforehand.

  warmline wait-for --pid 4242
  warmline wait-for --pidfile /tmp/backup.pid
  warmline wait-for --file /tmp/backup.done       # done when it appears
  warmline wait-for --log /tmp/backup.log --until 'transfer complete'
  warmline wait-for --pid 4242 --until-cold       # ...or the cache deadline

  -n SECS         poll every SECS (default 30)
  --until-cold    also return just before this session's prompt cache
                  expires, so the wake lands inside the TTL. Usable alone,
                  with no target at all
  --margin MIN    how far ahead of expiry --until-cold returns (default 2)
  --every MIN     heartbeat line every MIN minutes (default 50 -- inside the
                  cache TTL); 0 waits silently until the end
  --timeout MIN   give up after MIN minutes (default 600); 0 waits forever

Exit 0 the watched job ended, 1 timed out, 2 bad usage or a target that
never appeared, 3 the cache deadline came first (re-arm and end the turn).

Why not just background the worker: a background task that runs
'nohup ... &' returns immediately -- the harness reports it completed with
exit 0 while the real work runs on, detached, with nothing left to notify
you. Detach the worker deliberately, then watch it with this.

Why --until-cold beats a timed ping: it fires on the session's real expiry,
read from its own transcript, so a 5-minute cache isn't pinged on an hourly
schedule and an hourly one isn't pinged early for nothing. Paired with a
target it returns on whichever comes first, so a job that ends at minute 12
costs no ping at all -- and every turn that happens meanwhile pushes the
deadline out on its own, because the cache it was waiting on just got warm
again.
EOF
}

wf_elapsed() { # seconds -> 7m / 1h23m
  local m=$(( $1 / 60 ))
  if [ "$m" -lt 60 ]; then echo "${m}m"; else echo "$((m / 60))h$((m % 60))m"; fi
}

cmd_wait_for() {
  local interval=30 every=50 timeout=600 margin=2 until_cold=0
  # seconds per --every/--timeout minute; only the tests move it, so the
  # heartbeat, the timeout and the settle window are exercised for real
  local min="${WARMLINE_WAITFOR_MIN_SEC:-60}"
  local settle=$((5 * min))   # how long a target has to prove it exists
  local pid="" pidfile="" file="" log="" until_pat="" desc=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h|help) wait_for_usage; exit 0 ;;
      --until-cold) until_cold=1; shift ;;
      --pid|--pidfile|--file|--log|--until|-n|--every|--timeout|--margin)
        [ $# -ge 2 ] || { echo "warmline: $1 needs a value" >&2; exit 2; }
        case "$1" in
          --pid) pid="$2" ;;
          --pidfile) pidfile="$2" ;;
          --file) file="$2" ;;
          --log) log="$2" ;;
          --until) until_pat="$2" ;;
          -n) interval="$2" ;;
          --every) every="$2" ;;
          --timeout) timeout="$2" ;;
          --margin) margin="$2" ;;
        esac
        shift 2 ;;
      *) echo "warmline: unknown wait-for argument '$1' (see warmline wait-for --help)" >&2; exit 2 ;;
    esac
  done

  local pair
  for pair in "-n:$interval" "--every:$every" "--timeout:$timeout" "--margin:$margin"; do
    case "${pair#*:}" in
      ''|*[!0-9]*) echo "warmline: ${pair%%:*} needs a whole number" >&2; exit 2 ;;
    esac
  done
  [ "$interval" -gt 0 ] || { echo "warmline: -n must be at least 1 second" >&2; exit 2; }
  case "$pid" in
    '') ;;
    *[!0-9]*) echo "warmline: --pid needs a process id" >&2; exit 2 ;;
  esac
  if [ -n "$log" ] && [ -z "$until_pat" ]; then
    echo "warmline: --log needs --until PATTERN (what to wait for in it)" >&2; exit 2
  fi
  if [ -n "$until_pat" ] && [ -z "$log" ]; then
    echo "warmline: --until needs --log FILE (where to look for it)" >&2; exit 2
  fi
  local targets=0
  [ -n "$pid" ] && targets=$((targets + 1))
  [ -n "$pidfile" ] && targets=$((targets + 1))
  [ -n "$file" ] && targets=$((targets + 1))
  [ -n "$log" ] && targets=$((targets + 1))
  if [ "$targets" -gt 1 ] || { [ "$targets" -eq 0 ] && [ "$until_cold" = 0 ]; }; then
    echo "warmline: wait-for needs exactly one of --pid / --pidfile / --file / --log" >&2
    echo "(or --until-cold on its own, to wait only for the cache deadline)" >&2
    exit 2
  fi

  # the deadline is read from this session's own transcript, so an unreadable
  # one is a setup error worth failing on now rather than at expiry
  local audit_path=""
  if [ "$until_cold" = 1 ]; then
    audit_path="$(find_audit)"
    if [ -z "$audit_path" ] || ! "$audit_path" --cold-at >/dev/null 2>&1; then
      echo "warmline: --until-cold can't read this session's cache expiry" >&2
      echo "(needs warmline-audit and a transcript for the current project)" >&2
      exit 2
    fi
  fi

  # epoch second to return at: expiry minus the margin. Recomputed each poll,
  # because any turn in the meantime re-warms the cache and moves it out.
  wf_deadline() {
    local line epoch
    line="$("$audit_path" --cold-at 2>/dev/null)" || return 1
    epoch="${line%% *}"
    case "$epoch" in ''|*[!0-9]*) return 1 ;; esac
    echo $(( epoch - margin * min ))
  }

  # a target that never materializes is a launch bug, not a long wait: say so
  # in minutes rather than letting the agent block until the timeout
  local guard_what="" ready=0
  if [ -n "$pidfile" ]; then desc="pidfile $pidfile"; guard_what="pidfile $pidfile holds no pid"
  elif [ -n "$log" ]; then desc="'$until_pat' in $log"; guard_what="log file $log never appeared"
  elif [ -n "$file" ]; then desc="$file"; ready=1
  elif [ -n "$pid" ]; then desc="pid $pid"; ready=1
  else ready=1; fi   # --until-cold alone: the deadline is the only target

  # a zombie still answers kill -0, and a worker left un-detached by its
  # launcher is exactly the case that zombies -- so ask ps for the state
  wf_alive() {
    local st
    st="$(ps -o state= -p "$1" 2>/dev/null | tr -d ' \t')"
    if [ -z "$st" ]; then
      # no ps (or no such process): fall back, but a reaped pid is gone
      kill -0 "$1" 2>/dev/null || return 1
      ps -p "$1" >/dev/null 2>&1 && return 0 || return 1
    fi
    case "$st" in Z*) return 1 ;; esac
    return 0
  }

  wf_done() {
    if [ -n "$pid" ]; then
      wf_alive "$pid" && return 1 || return 0
    elif [ -n "$pidfile" ]; then
      local p=""
      [ -s "$pidfile" ] && p="$(tr -dc '0-9' < "$pidfile" 2>/dev/null)"
      [ -n "$p" ] || return 1
      ready=1
      wf_alive "$p" && return 1 || return 0
    elif [ -n "$file" ]; then
      [ -e "$file" ] && return 0 || return 1
    else
      [ -e "$log" ] && ready=1
      grep -Eq -- "$until_pat" "$log" 2>/dev/null && return 0 || return 1
    fi
  }

  local start now elapsed deadline next_beat=$((every * min))
  start=$(date +%s)
  while :; do
    if [ "$targets" -gt 0 ] && wf_done; then
      now=$(date +%s)
      echo "warmline wait-for: $desc finished after $(wf_elapsed $((now - start)))"
      return 0
    fi
    now=$(date +%s); elapsed=$((now - start))
    if [ "$until_cold" = 1 ] && deadline="$(wf_deadline)" && [ "$now" -ge "$deadline" ]; then
      echo "warmline wait-for: cache deadline reached after $(wf_elapsed "$elapsed")${desc:+ (still waiting on $desc)}"
      return 3
    fi
    if [ -n "$guard_what" ] && [ "$ready" = 0 ] && [ "$elapsed" -ge "$settle" ]; then
      echo "warmline wait-for: $guard_what after $(wf_elapsed "$elapsed")." >&2
      echo "the worker probably never started -- check how it was launched." >&2
      return 2
    fi
    if [ "$timeout" -gt 0 ] && [ "$elapsed" -ge $((timeout * min)) ]; then
      echo "warmline wait-for: gave up on ${desc:-the cache deadline} after $(wf_elapsed "$elapsed")" >&2
      return 1
    fi
    if [ "$every" -gt 0 ] && [ "$elapsed" -ge "$next_beat" ]; then
      echo "warmline wait-for: still waiting on ${desc:-the cache deadline} ($(wf_elapsed "$elapsed"))"
      next_beat=$((next_beat + every * min))
    fi
    sleep "$interval"
  done
}

command -v python3 >/dev/null || { echo "warmline needs python3 on PATH" >&2; exit 1; }

case "${1:-}" in
  status) cmd_status ;;
  setup) shift; cmd_setup "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  awake) shift; cmd_awake "$@" ;;
  wait-for) shift; cmd_wait_for "$@" ;;
  keep-warm)
    case "${2:-}" in
      on) kw_on ;;
      off) kw_off ;;
      status) kw_status ;;
      ""|--help|-h|help) kw_usage ;;
      *) echo "warmline: unknown keep-warm action '${2}' (see warmline keep-warm --help)" >&2; exit 2 ;;
    esac ;;
  audit) shift; cmd_audit "$@" ;;
  ""|--help|-h|help) usage ;;
  *) echo "warmline: unknown command '${1}' (see warmline --help)" >&2; exit 2 ;;
esac
